{
  "name": "courrier",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "postbuild": "node scripts/configure-worker-entry.mjs",
    "dev": "nuxt dev",
    "account:bootstrap-canary-member": "node scripts/bootstrap-canary-member.mjs",
    "account:recover-platform-admin-mfa": "node scripts/recover-platform-admin-mfa.mjs",
    "account:reset-local-admin-password": "node scripts/reset-local-admin-password.mjs",
    "account:test-canary-platform-admin": "node scripts/test-canary-platform-admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:canary": "wrangler d1 migrations apply DB --remote --config wrangler.canary.jsonc",
    "generate": "nuxt generate",
    "test:auth": "node --experimental-strip-types --test tests/workspace-access-policy.test.ts && node --test tests/admin-authorization-redirect.test.mjs tests/admin-authorization-recovery.test.mjs tests/admin-mfa-recovery.test.mjs tests/canary-admin-smoke.test.mjs tests/canary-admin-recovery.test.mjs && node tests/account-access.integration.mjs",
    "test:email": "node --experimental-strip-types --import ./tests/node-ts-resolver.mjs --test tests/*.test.ts",
    "restore:inspect": "node scripts/restore-mailbox.mjs inspect",
    "restore:apply": "node scripts/restore-mailbox.mjs restore",
    "preview": "npm run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:canary": "npm run build && npm run db:migrate:canary && wrangler deploy --config wrangler.canary.jsonc",
    "cf-typegen": "wrangler types",
    "account:test-canary-admin-recovery": "node scripts/test-canary-admin-recovery.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@simplewebauthn/types": "^11.0.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@una-ui/nuxt": "^1.0.0-alpha.27",
    "@unocss/nuxt": "^66.10.5",
    "jose": "^6.2.12",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-i18n-micro": "^3.21.2",
    "postal-mime": "^4.0.0",
    "tronche": "^1.6.1",
    "unocss": "^66.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/tabler": "^1.2.37",
    "@types/node": "^26.6.3",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
    "wrangler": "^4.142.0"
  }
}
